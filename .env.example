# Environment Configuration Template
# COPY THIS FILE TO .env OR .env.local BEFORE STARTING
# DO NOT COMMIT SECRETS OR REAL API KEYS TO VERSION CONTROL

# Application Hosting URL
# In local development: http://localhost:3000
# In production on Cloudflare Pages: https://your-site.pages.dev
APP_URL="http://localhost:3000"

# AI / Backend Integrations (Optional)
# IMPORTANT SECURITY NOTICE:
# In client-side React + Vite single page applications, variables prefixed with VITE_*
# are bundled into client-side JavaScript and are visible to anyone inspecting the browser.
# Private API keys (such as GEMINI_API_KEY) must NEVER be exposed via VITE_* in client bundles.
# When adding AI capabilities in production, proxy all requests through a secure serverless backend
# (e.g., Cloudflare Pages Functions `/api/*` or Express Node.js backend).
#
# GEMINI_API_KEY="your-gemini-api-key-here"
